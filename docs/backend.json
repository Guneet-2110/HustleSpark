
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the HustleSpark application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "The subscription status of the user (e.g., 'active', 'inactive', 'trial')."
        },
        "savedHustleIds": {
          "type": "array",
          "description": "References to Saved Hustles. (Relationship: User 1:N SavedHustle)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "email",
        "subscriptionStatus"
      ]
    },
    "MarketplaceListing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketplaceListing",
      "type": "object",
      "description": "Represents a hustle listed for sale on the marketplace.",
      "properties": {
        "id": {
          "type": "string"
        },
        "hustleName": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "flyerUrl": {
          "type": "string",
          "format": "uri"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        },
        "pitch": {
          "type": "string",
          "description": "Detailed business pitch."
        },
        "experience": {
          "type": "string",
          "description": "User experience in this field."
        },
        "whoIHelp": {
          "type": "string",
          "description": "Target audience description."
        },
        "workFrom": {
          "type": "string",
          "description": "Location flexibility (Remote/Local)."
        },
        "paypalEmail": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["pending_approval", "approved", "rejected"],
          "default": "pending_approval"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "hustleName",
        "userId",
        "price",
        "pitch",
        "paypalEmail",
        "category",
        "country",
        "state",
        "city"
      ]
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "hustleName": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction in escrow status.",
      "properties": {
        "buyerId": { "type": "string" },
        "buyerEmail": { "type": "string", "format": "email" },
        "sellerId": { "type": "string" },
        "sellerEmail": { "type": "string", "format": "email" },
        "listingId": { "type": "string" },
        "hustleName": { "type": "string" },
        "amount": { "type": "number" },
        "sellerAmount": { "type": "number" },
        "platformFee": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_delivery", "pending_confirmation", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/marketplace_listings/{marketplaceListingId}": {
      "schema": {
        "$ref": "#/backend/entities/MarketplaceListing"
      },
      "description": "Publicly accessible marketplace listings."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/backend/entities/Chat"
      },
      "description": "Conversations between buyers and sellers."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/backend/entities/ChatMessage"
      },
      "description": "Individual messages in a chat."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/backend/entities/Transaction"
      },
      "description": "Escrow transactions for marketplace sales."
    }
  }
}
