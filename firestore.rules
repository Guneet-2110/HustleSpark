
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      // Owner and verified testers approval and oversight privileges
      return isSignedIn() && (
        request.auth.token.email == 'guneet.ar2010@gmail.com' || 
        request.auth.token.email == 'tester@gmail.com'
      );
    }
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
      match /saved_hustles/{savedHustleId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    match /marketplace_listings/{marketplaceListingId} {
      allow create: if isSignedIn() && request.resource.data.status == 'pending_approval';
      allow list, get: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /chats/{chatId} {
      allow read, write: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId));
      allow create: if isSignedIn();
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read, create: if isAdmin() || (isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId));
        allow delete: if isAdmin();
      }
    }
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId));
      allow delete: if isAdmin();
    }
  }
}
