
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'guneet.ar2010@gmail.com';
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /saved_hustles/{savedHustleId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /marketplace_listings/{marketplaceListingId} {
      // 1. Authenticated users can create marketplace_listings with status "pending_approval"
      allow create: if isSignedIn() && request.resource.data.status == 'pending_approval';
      
      // 2. & 3. Only approved listings are visible to the public/unauthenticated
      allow list: if resource.data.status == 'approved' || isAdmin();
      allow get: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // 4. Admin can read and update all listings.
      // 5. Sellers can read/update their own listings, but cannot change the status.
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.status == resource.data.status
      );
      
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId);
        allow create: if isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId);
      }
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
    }
  }
}
